---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const entries = await getCollection('bsips');
const bsips = entries
  .map((e) => ({ id: e.id, ...e.data }))
  .sort((a, b) => Number(a.bsip) - Number(b.bsip));

const badgeClass = (s) => `badge s-${String(s).replace(/\s+/g, '-')}`;
const meta = (b) => [b.type, b.category].filter(Boolean).join(' · ');
---

<Base title="Bitsocial Improvement Proposals">
  <p class="eyebrow">The Bitsocial protocol</p>
  <h1 class="page-title">Improvement Proposals</h1>
  <p class="lede">
    BSIPs are the design documents that specify the decentralized Bitsocial protocol: the
    peer-to-peer social core, networking, interfaces, the Bitsocial Network appchain, and the
    standards independent clients share. Start with <a href="/bsip-1">BSIP-1</a>.
  </p>

  <div class="index">
    {
      bsips.map((b) => (
        <a class="index-row" href={`/${b.id}`}>
          <span class="index-num">{b.bsip}</span>
          <span class="index-main">
            <span class="index-title">{b.title}</span>
            <span class="index-desc">{b.description}</span>
            <span class="index-meta">{meta(b)}</span>
          </span>
          <span class="index-status">
            <span class={badgeClass(b.status)}>{b.status}</span>
          </span>
        </a>
      ))
    }
  </div>
</Base>
