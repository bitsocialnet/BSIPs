---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StatusChip from '../components/StatusChip.astro';
import { GITHUB_REPO_URL, getBsips, getRequiredBy, isoDate, parseAuthors } from '../lib/bsips';

export async function getStaticPaths() {
  const entries = await getCollection('bsips');
  for (const entry of entries) {
    if (entry.id !== `bsip-${entry.data.bsip}`) {
      throw new Error(`${entry.id}.md declares bsip: ${entry.data.bsip}; the file must be named bsip-${entry.data.bsip}.md`);
    }
  }
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const fm = entry.data;

const bsips = await getBsips();
const byNumber = new Map(bsips.map((b) => [b.bsip, b]));
const requires = (fm.requires ?? []).map((n) => byNumber.get(n)).filter((b) => b !== undefined);
const requiredBy = getRequiredBy(bsips, fm.bsip);
const authors = parseAuthors(fm.author);

const path = `BSIPS/${entry.id}.md`;
const sourceUrl = `${GITHUB_REPO_URL}/blob/master/${path}`;
const rawUrl = `https://raw.githubusercontent.com/bitsocialnet/BSIPs/master/${path}`;
const historyUrl = `${GITHUB_REPO_URL}/commits/master/${path}`;
const discussionsUrl = fm['discussions-to'];
const hasDiagrams = /^```mermaid\s*$/m.test(entry.body ?? '');

// Heading text from the collector includes the prepended "#" anchor.
const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ ...h, text: h.text.replace(/^\s*#\s*/, '') }));
---

<Base title={`BSIP-${fm.bsip}: ${fm.title}`} description={fm.description}>
  <div class="container doc">
    {
      toc.length > 0 && (
        <nav class="doc-toc" aria-label="On this page">
          <p class="rail-title">On this page</p>
          <ul>
            {toc.map((h) => (
              <li class={`lvl-${h.depth}`}>
                <a href={`#${h.slug}`} data-toc-link={h.slug}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <header class="doc-header">
      <div class="doc-topline">
        <a href="/" class="back-link"><Icon name="arrow-left" />All BSIPs</a>
        <div class="button-group">
          <button type="button" class="small-button" data-copy-link>
            <Icon name="copy" class="ic-copy" />
            <Icon name="check" class="ic-done" />
            <span data-copy-label>Copy link</span>
          </button>
          <a href={rawUrl} class="small-button" title="Raw markdown">.md</a>
          <a href={sourceUrl} class="small-button" title="View on GitHub"><Icon name="github" />GitHub</a>
        </div>
      </div>
      <p class="number-badge">BSIP-{fm.bsip}</p>
      <h1>{fm.title}</h1>
      <p class="doc-desc">{fm.description}</p>
      <div class="chips">
        <StatusChip status={fm.status} />
        <span class="chip">{fm.category ?? fm.type}</span>
      </div>
    </header>

    <article class="doc-content">
      {
        toc.length > 0 && (
          <details class="toc-inline">
            <summary>On this page</summary>
            <ul>
              {toc.map((h) => (
                <li class={`lvl-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </article>

    <aside class="doc-rail" aria-label="About this BSIP">
      <section class="rail-card">
        <h2 class="rail-title">About this BSIP</h2>
        <dl class="facts">
          <div>
            <dt>Status</dt>
            <dd><StatusChip status={fm.status} /></dd>
          </div>
          {
            fm['last-call-deadline'] && (
              <div>
                <dt>Last call ends</dt>
                <dd><time datetime={isoDate(fm['last-call-deadline'])}>{isoDate(fm['last-call-deadline'])}</time></dd>
              </div>
            )
          }
          <div>
            <dt>Type</dt>
            <dd>{fm.type}</dd>
          </div>
          {
            fm.category && (
              <div>
                <dt>Category</dt>
                <dd>{fm.category}</dd>
              </div>
            )
          }
          <div>
            <dt>{authors.length > 1 ? 'Authors' : 'Author'}</dt>
            <dd>
              {authors.map((a) => (
                <span class="author">
                  {a.name}
                  {a.github && <a href={`https://github.com/${a.github}`}>@{a.github}</a>}
                </span>
              ))}
            </dd>
          </div>
          <div>
            <dt>Created</dt>
            <dd><time datetime={isoDate(fm.created)}>{isoDate(fm.created)}</time></dd>
          </div>
          {
            fm['withdrawal-reason'] && (
              <div>
                <dt>Withdrawal reason</dt>
                <dd>{fm['withdrawal-reason']}</dd>
              </div>
            )
          }
          <div>
            <dt>Discussion</dt>
            <dd><a href={discussionsUrl}>{/github\.com\/[^/]+\/[^/]+\/issues\/?$/.test(discussionsUrl) ? 'GitHub issues' : new URL(discussionsUrl).host}</a></dd>
          </div>
          <div>
            <dt>Source</dt>
            <dd><a href={sourceUrl}>View on GitHub</a></dd>
          </div>
        </dl>
      </section>

      <div class="rail-related">
        {
          requires.length > 0 && (
            <section class="rail-card">
              <h2 class="rail-title">
                Requires <span class="count">{requires.length}</span>
              </h2>
              <ul class="mini-list">
                {requires.map((b) => (
                  <li>
                    <a href={`/${b.id}`} class="mini-bsip">
                      <span class="mini-head">
                        <span class="mini-num">BSIP-{b.bsip}</span>
                        <StatusChip status={b.status} />
                      </span>
                      <span class="mini-title">{b.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          requiredBy.length > 0 && (
            <details class="rail-card rail-collapsible">
              <summary class="rail-title">
                <Icon name="chevron-right" class="summary-icon" />
                Required by <span class="count">{requiredBy.length}</span>
              </summary>
              <ul class="mini-list">
                {requiredBy.map((b) => (
                  <li>
                    <a href={`/${b.id}`} class="mini-bsip">
                      <span class="mini-head">
                        <span class="mini-num">BSIP-{b.bsip}</span>
                        <StatusChip status={b.status} />
                      </span>
                      <span class="mini-title">{b.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }

        <a href={historyUrl} class="rail-button"><Icon name="history" />Change history</a>
      </div>
    </aside>
  </div>

  {
    hasDiagrams && (
      <dialog class="diagram-dialog" aria-label="Diagram" data-diagram-dialog>
        <div class="diagram-dialog-bar">
          <p class="diagram-dialog-hint">Pinch, ctrl/⌘ + scroll or +/− to zoom; drag to pan</p>
          <button type="button" class="diagram-close" aria-label="Close diagram" title="Close" data-diagram-close>
            <Icon name="x" />
          </button>
        </div>
        <div class="diagram-stage" data-diagram-stage />
      </dialog>
    )
  }
</Base>

<script>
  // Copy link: the page URL without the section hash.
  const copy = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  const label = copy?.querySelector('[data-copy-label]');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.origin + location.pathname);
      copy.dataset.copied = '';
      if (label) label.textContent = 'Copied';
      setTimeout(() => {
        delete copy.dataset.copied;
        if (label) label.textContent = 'Copy link';
      }, 1600);
    } catch {
      if (label) label.textContent = 'Copy failed';
    }
  });

  // Mark the section being read in the table of contents: the last heading above the top quarter.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [a.dataset.tocLink!, a]));
  const headings = [...links.keys()].map((id) => document.getElementById(id)).filter((h): h is HTMLElement => h !== null);
  let active: HTMLAnchorElement | undefined;
  let queued = false;
  const update = () => {
    queued = false;
    const line = window.innerHeight * 0.25;
    let current: HTMLElement | undefined;
    for (const h of headings) {
      if (h.getBoundingClientRect().top <= line) current = h;
      else break;
    }
    // At the bottom of the page the last sections can never reach the line; show the last one.
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = headings[headings.length - 1];
    const link = current && links.get(current.id);
    if (link === active) return;
    active?.removeAttribute('aria-current');
    link?.setAttribute('aria-current', 'location');
    active = link;
  };
  const queue = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  };
  if (headings.length) {
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
  }

  // Diagram viewer: move the diagram's SVG into a full-screen dialog, fit it to the screen and let
  // Pele's zoom (loaded on first use) handle zoom and pan. Closing puts the SVG back.
  const dialog = document.querySelector<HTMLDialogElement>('[data-diagram-dialog]');
  const stage = dialog?.querySelector<HTMLElement>('[data-diagram-stage]');
  if (dialog && stage) {
    let home: Element | undefined;
    let svg: SVGSVGElement | undefined;
    let inlineStyle = '';
    let zoom: { destroy(): void } | undefined;

    const fit = async () => {
      zoom?.destroy();
      zoom = undefined;
      if (!svg) return;
      const width = Number(svg.getAttribute('width'));
      const height = Number(svg.getAttribute('height'));
      const box = stage.getBoundingClientRect();
      const padding = 32;
      const scale = Math.min((box.width - padding) / width, (box.height - padding) / height, 2);
      svg.style.width = `${Math.floor(width * scale)}px`;
      const { enableZoom } = await import('pele/core');
      // The dialog may have closed, or another resize started, while Pele loaded.
      if (!dialog.open || svg.parentElement !== stage || zoom) return;
      zoom = enableZoom(stage, { always: true, maxScale: 4 });
    };

    let resizeQueued = false;
    addEventListener('resize', () => {
      if (!dialog.open || resizeQueued) return;
      resizeQueued = true;
      requestAnimationFrame(() => {
        resizeQueued = false;
        void fit();
      });
    });

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-diagram-expand]')) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        home = button.closest('.diagram')?.querySelector('.diagram-scroll') ?? undefined;
        svg = home?.querySelector('svg') ?? undefined;
        if (!svg) return;
        inlineStyle = svg.getAttribute('style') ?? '';
        stage.append(svg);
        dialog.showModal();
        await fit();
        svg.focus({ preventScroll: true });
      });
    }

    dialog.querySelector('[data-diagram-close]')?.addEventListener('click', () => dialog.close());
    // A click on the dialog element itself is a click on the backdrop.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      zoom?.destroy();
      zoom = undefined;
      if (svg && home) {
        svg.setAttribute('style', inlineStyle);
        home.append(svg);
      }
      svg = undefined;
      home = undefined;
    });
  }
</script>
