---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('bsips');
  for (const entry of entries) {
    if (entry.id !== `bsip-${entry.data.bsip}`) {
      throw new Error(`${entry.id}.md declares bsip: ${entry.data.bsip}; the file must be named bsip-${entry.data.bsip}.md`);
    }
  }
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const fm = entry.data;

const created = fm.created.toISOString().slice(0, 10);
const requires = fm.requires ?? [];

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const badgeClass = `badge s-${String(fm.status).replace(/\s+/g, '-')}`;
const kind = [fm.type, fm.category].filter(Boolean).join(' · ');
const ghUrl = `https://github.com/bitsocialnet/BSIPs/blob/master/BSIPS/${entry.id}.md`;
---

<Base title={`BSIP-${fm.bsip}: ${fm.title}`} description={fm.description}>
  <a class="back" href="/">← All BSIPs</a>

  <div class="doc-grid">
    <div>
      <div class="doc-eyebrow">
        <span class={badgeClass}>{fm.status}</span>
        <span class="doc-kind">{kind}</span>
      </div>

      <h1 class="page-title">BSIP-{fm.bsip}: {fm.title}</h1>

      <div class="preamble">
        <dl>
          <dt>Author</dt>
          <dd>{fm.author}</dd>
          <dt>Created</dt>
          <dd>{created}</dd>
          {
            requires.length > 0 && (
              <>
                <dt>Requires</dt>
                <dd>
                  {requires.map((r, i) => (
                    <span>
                      {i > 0 ? ', ' : ''}
                      <a href={`/bsip-${r}`}>BSIP-{r}</a>
                    </span>
                  ))}
                </dd>
              </>
            )
          }
        </dl>
      </div>

      <article class="prose">
        <Content />
      </article>

      <p class="edit-link"><a href={ghUrl}>Edit this BSIP on GitHub →</a></p>
    </div>

    {
      toc.length > 0 && (
        <aside class="toc" aria-label="Table of contents">
          <p class="toc-label">On this page</p>
          <ul>
            {toc.map((h) => (
              <li class={`lvl-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text.replace(/\s*#+\s*$/, '')}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>
