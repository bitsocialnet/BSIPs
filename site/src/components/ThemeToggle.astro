---
// Three-state theme toggle: auto -> light -> dark. The no-flash init lives in
// Base.astro <head>; this only handles the click cycle and icon state.
---

<button id="theme-toggle" type="button" class="theme-toggle" title="Switch theme (system, light, dark)" aria-label="Switch theme">
  <!-- system / auto -->
  <svg class="ic ic-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2.5" y="4" width="19" height="13" rx="2" /><path d="M8.5 21h7M12 17v4" />
  </svg>
  <!-- light / sun -->
  <svg class="ic ic-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
  </svg>
  <!-- dark / moon -->
  <svg class="ic ic-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" />
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle')!;
  const order = ['auto', 'light', 'dark'] as const;
  const current = () => {
    const t = localStorage.getItem('theme');
    return t === 'light' || t === 'dark' ? t : 'auto';
  };
  const apply = (mode: string) => {
    if (mode === 'auto') {
      localStorage.removeItem('theme');
      delete document.documentElement.dataset.theme;
    } else {
      localStorage.setItem('theme', mode);
      document.documentElement.dataset.theme = mode;
    }
    btn.dataset.mode = mode;
  };
  btn.dataset.mode = current();
  btn.addEventListener('click', () => apply(order[(order.indexOf(current() as any) + 1) % order.length]));
</script>
