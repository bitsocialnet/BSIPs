---
import '@fontsource-variable/exo';
import '@fontsource-variable/manrope';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getBsips } from '../lib/bsips';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Specifications for the decentralized Bitsocial protocol.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/logo-on-black-512.png', Astro.site);
const bsips = await getBsips();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/logo-transparent-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/logo-transparent-512.png" />
    <link rel="apple-touch-icon" href="/logo-transparent-180.png" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Bitsocial Improvement Proposals" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Bitsocial logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    {/* Set the stored theme before paint to avoid a flash */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader bsips={bsips} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {/* Vercel Web Analytics: a custom element, so it goes in <body> rather than <head>. */}
    <Analytics />

    <script>
      // Header search. A BSIP number ("7", "bsip-7") opens that BSIP. Anything else filters the index in
      // place, or opens the index with the query from other pages.
      const form = document.querySelector<HTMLFormElement>('[data-search-form]')!;
      const input = form.querySelector<HTMLInputElement>('[data-search-input]')!;
      const ids = new Set(form.dataset.ids!.split(',').map(Number));
      const rows = [...document.querySelectorAll<HTMLElement>('[data-bsip-row]')];
      const onIndex = rows.length > 0;
      const numberOf = (query: string) => {
        const match = query.trim().match(/^(?:bsip)?[\s-]*(\d+)$/i);
        return match ? Number(match[1]) : null;
      };

      form.addEventListener('submit', (event) => {
        const n = numberOf(input.value);
        if (n !== null && ids.has(n)) {
          event.preventDefault();
          location.href = `/bsip-${n}`;
        } else if (onIndex) {
          event.preventDefault();
        }
      });

      // "/" focuses the search, as on GitHub.
      document.addEventListener('keydown', (event) => {
        if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
        const target = event.target as HTMLElement;
        if (target.closest('input, textarea, select, [contenteditable="true"]')) return;
        event.preventDefault();
        input.focus();
      });

      if (onIndex) {
        const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
        const empty = document.querySelector<HTMLElement>('[data-search-empty]')!;
        const emptyTerm = empty.querySelector('[data-search-term]')!;
        const count = document.querySelector<HTMLElement>('[data-search-count]');
        const nav = document.querySelector<HTMLElement>('[data-category-nav]');
        const filter = () => {
          const raw = input.value.trim();
          const query = raw.toLowerCase();
          const n = numberOf(query);
          const terms = query.split(/\s+/).filter(Boolean);
          for (const row of rows) {
            const match = n !== null ? Number(row.dataset.bsip) === n : terms.every((t) => row.dataset.search!.includes(t));
            row.hidden = !match;
          }
          for (const group of groups) group.hidden = !group.querySelector('[data-bsip-row]:not([hidden])');
          // The category chips jump to sections a query can hide and count every BSIP, so they only fit the full list.
          if (nav) nav.hidden = raw !== '';
          const shown = rows.filter((row) => !row.hidden).length;
          empty.hidden = shown > 0;
          emptyTerm.textContent = raw;
          if (count) count.textContent = raw ? `${shown} of ${rows.length} match “${raw}”` : '';
          const url = new URL(location.href);
          if (raw) url.searchParams.set('q', raw);
          else url.searchParams.delete('q');
          history.replaceState(history.state, '', url);
        };
        input.value = new URLSearchParams(location.search).get('q') ?? '';
        input.addEventListener('input', filter);
        if (input.value) filter();
      }
    </script>
  </body>
</html>
